# Inventory service configuration (Twelve-Factor: all config via environment).
# Copy to .env for local use. Do not commit real secrets.

SERVICE_NAME=inventory-service
ENVIRONMENT=development
HTTP_ADDR=:8081
LOG_LEVEL=info

# Database (own instance, separate from the order service: database per service)
DATABASE_URL=postgres://inventory:inventory@localhost:5433/inventory?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h

# Observability (leave OTLP endpoint empty to disable tracing locally)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_RATIO=1.0

# Authentication (disabled by default for local development)
AUTH_ENABLED=false
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=inventory-service
AUTH_JWT_AUDIENCE=inventory-api

# HTTP server timeouts
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
