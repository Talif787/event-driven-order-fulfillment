# Order service configuration (Twelve-Factor: all config via environment).
# Copy to .env for local use. Do not commit real secrets.

SERVICE_NAME=order-service
ENVIRONMENT=development
HTTP_ADDR=:8080
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://order:order@localhost:5432/order?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h

# Observability (leave OTLP endpoint empty to disable tracing locally)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_RATIO=1.0

# Authentication (disabled by default for local development)
AUTH_ENABLED=false
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=order-service
AUTH_JWT_AUDIENCE=order-api

# HTTP server timeouts
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
