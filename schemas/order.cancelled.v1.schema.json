{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orderfulfillment.dev/order.cancelled.v1.json",
  "title": "order.cancelled.v1",
  "description": "Emitted when the saga compensates and cancels an order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orderId",
    "reason",
    "cancelledAt"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string"
    },
    "cancelledAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
