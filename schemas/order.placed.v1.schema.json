{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orderfulfillment.dev/order.placed.v1.json",
  "title": "order.placed.v1",
  "description": "Emitted when an order is placed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orderId",
    "customerId",
    "items",
    "shipTo",
    "totalMinor",
    "currency",
    "placedAt"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "customerId": {
      "type": "string",
      "format": "uuid"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lineItem"
      }
    },
    "shipTo": {
      "$ref": "#/$defs/address"
    },
    "totalMinor": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "placedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "lineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "quantity",
        "unitPriceMinor"
      ],
      "properties": {
        "sku": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "unitPriceMinor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line1",
        "line2",
        "city",
        "region",
        "postalCode",
        "country"
      ],
      "properties": {
        "line1": {
          "type": "string"
        },
        "line2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "postalCode": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    }
  }
}
